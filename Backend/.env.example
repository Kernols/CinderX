# Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/cinderx?retryWrites=true&w=majority

# Security & Encryption (REQUIRED in production)
ENCRYPTION_KEY=your-32-char-encryption-key-here
WALLET_ENCRYPTION_KEY=your-32-char-wallet-encryption-key-here
APP_AUTH_JWT_SECRET=your-jwt-secret-here
APP_AUTH_TOKEN_EXPIRY=24h

# Clerk Authentication (Optional if using Wallet Auth only)
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
CLERK_JWT_KEY=...
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Firebase (For notifications and legacy auth)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Stellar Network & Escrow
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_CONTRACT_ID=C...
STELLAR_ESCROW_PUBLIC=G...
STELLAR_ESCROW_SECRET=S...
TREASURY_SECRET=S...

# Pinata IPFS
PINATA_JWT=your-pinata-jwt

# AI Judge (OpenAI)
OPENAI_API_KEY=sk-...

# Observability
LOG_LEVEL=info
SENTRY_DSN=https://...@sentry.io/...

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
